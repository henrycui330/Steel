# Copy to .env and fill in after deploying the Worker (see doc/cloudflare-auth.md)
# Leave empty to use Offline auth only.

# Local: /steel-api (Vite proxies to Worker). Prefer local wrangler when workers.dev is blocked.
VITE_STEEL_API=/steel-api
VITE_STEEL_API_PROXY=http://127.0.0.1:8787
# Remote alternative (needs workers.dev reachable):
# VITE_STEEL_API_PROXY=https://steel-auth.YOUR_SUBDOMAIN.workers.dev
